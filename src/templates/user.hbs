<article class="user-card">
  <div class="user-card__content">
    <h3 class="user-card__name">
      {{name}}
    </h3>
    <p class="user-card__email">
      {{email}}
    </p>
    <p class="user-card__age">
      Age:
      {{age}}
    </p>
  </div>

  <div class="user-card__actions">
    <button
      class="button button--secondary edit-user"
      type="button"
      data-id="{{id}}"
      data-name="{{name}}"
      data-email="{{email}}"
      data-age="{{age}}"
    >
      Edit
    </button>
    <button
      class="button button--danger delete-user"
      type="button"
      data-id="{{id}}"
    >
      Delete
    </button>
    <button
      class="button button--secondary load-tasks"
      id="loadTasksBtn"
      type="button"
      data-id="{{id}}"
    >
      Load Tasks
    </button>
  </div>
</article>